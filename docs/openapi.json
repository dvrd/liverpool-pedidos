{
  "openapi": "3.0.1",
  "info": {
    "title": "Mesa de pedidos",
    "description": "API REST para que el equipo de ventas gestione clientes y pedidos originados en la aplicación y en el sitio web. El importe del pedido se calcula como precio unitario por cantidad. El pedido conserva una copia de los datos del cliente al momento de crearse.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Salud",
      "description": "Comprueba que el servicio y MongoDB responden"
    },
    {
      "name": "Pedidos",
      "description": "Pedidos originados en la aplicación y en el sitio web"
    },
    {
      "name": "Clientes",
      "description": "Clientes que realizan pedidos desde la aplicación o el sitio web"
    }
  ],
  "paths": {
    "/api/v1/orders/{id}": {
      "get": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Consulta el detalle de un pedido",
        "operationId": "get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Reemplaza los datos operativos de un pedido",
        "operationId": "update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOrderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Elimina un pedido",
        "operationId": "delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/customers/{id}": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "summary": "Consulta un cliente",
        "operationId": "get_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerRecord"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Clientes"
        ],
        "summary": "Actualiza los datos de un cliente",
        "operationId": "update_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCustomerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerRecord"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Clientes"
        ],
        "summary": "Elimina un cliente sin pedidos",
        "operationId": "delete_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/orders": {
      "get": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Lista pedidos, con filtro por término y estatus",
        "operationId": "list",
        "parameters": [
          {
            "name": "term",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseOrderResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Crea un pedido",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/customers": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "summary": "Lista los clientes",
        "operationId": "list_1",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CustomerRecord"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Clientes"
        ],
        "summary": "Crea un cliente",
        "operationId": "create_1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCustomerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerRecord"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{id}/status": {
      "patch": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Cambia el estatus y lo agrega al historial",
        "operationId": "changeStatus",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeStatusRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/suggestions": {
      "get": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Opciones del typeahead a partir de dos caracteres",
        "operationId": "suggestions",
        "parameters": [
          {
            "name": "term",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SuggestionResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Salud"
        ],
        "summary": "Estado del servicio y de la base",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdateOrderRequest": {
        "required": [
          "channel",
          "productCode",
          "productDescription",
          "quantity",
          "shippingAddress",
          "status",
          "unitPrice"
        ],
        "type": "object",
        "properties": {
          "shippingAddress": {
            "maxLength": 240,
            "minLength": 0,
            "type": "string"
          },
          "productCode": {
            "pattern": "^[A-Za-z0-9-]{4,32}$",
            "type": "string"
          },
          "productDescription": {
            "maxLength": 140,
            "minLength": 0,
            "type": "string"
          },
          "quantity": {
            "maximum": 99,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "unitPrice": {
            "minimum": 0.01,
            "exclusiveMinimum": false,
            "type": "number"
          },
          "channel": {
            "type": "string",
            "enum": [
              "APP",
              "WEBSITE"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "CONFIRMED",
              "PREPARING",
              "SHIPPED",
              "DELIVERED",
              "CANCELLED"
            ]
          }
        },
        "description": "Reemplazo de los datos operativos del pedido. El cliente y el folio no cambian."
      },
      "CustomerResponse": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "paternalLastName": {
            "type": "string"
          },
          "maternalLastName": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "OrderResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "orderNumber": {
            "type": "string"
          },
          "channel": {
            "type": "string",
            "enum": [
              "APP",
              "WEBSITE"
            ]
          },
          "customerId": {
            "type": "string"
          },
          "customer": {
            "$ref": "#/components/schemas/CustomerResponse"
          },
          "shippingAddress": {
            "type": "string"
          },
          "productCode": {
            "type": "string"
          },
          "productDescription": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "unitPrice": {
            "type": "number"
          },
          "totalAmount": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "CONFIRMED",
              "PREPARING",
              "SHIPPED",
              "DELIVERED",
              "CANCELLED"
            ]
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StatusEventResponse"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "StatusEventResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "CONFIRMED",
              "PREPARING",
              "SHIPPED",
              "DELIVERED",
              "CANCELLED"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdateCustomerRequest": {
        "required": [
          "email",
          "firstName",
          "maternalLastName",
          "paternalLastName"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "maxLength": 80,
            "minLength": 0,
            "type": "string"
          },
          "paternalLastName": {
            "maxLength": 80,
            "minLength": 0,
            "type": "string"
          },
          "maternalLastName": {
            "maxLength": 80,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "maxLength": 160,
            "minLength": 0,
            "type": "string"
          }
        },
        "description": "Reemplazo de los datos de un cliente"
      },
      "CustomerRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "paternalLastName": {
            "type": "string"
          },
          "maternalLastName": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateOrderRequest": {
        "required": [
          "channel",
          "customerId",
          "productCode",
          "productDescription",
          "quantity",
          "shippingAddress",
          "unitPrice"
        ],
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "description": "Identificador del cliente",
            "example": "665f1c2b8a0d1e2f3a4b5c6d"
          },
          "shippingAddress": {
            "maxLength": 240,
            "minLength": 0,
            "type": "string",
            "example": "Av. Presidente Masaryk 111, Polanco, Miguel Hidalgo, CDMX, 11560"
          },
          "productCode": {
            "pattern": "^[A-Za-z0-9-]{4,32}$",
            "type": "string",
            "example": "LP-MOD-10442"
          },
          "productDescription": {
            "maxLength": 140,
            "minLength": 0,
            "type": "string",
            "example": "Vestido midi de lino"
          },
          "quantity": {
            "maximum": 99,
            "minimum": 1,
            "type": "integer",
            "format": "int32",
            "example": 1
          },
          "unitPrice": {
            "minimum": 0.01,
            "exclusiveMinimum": false,
            "type": "number",
            "description": "Precio unitario en MXN",
            "example": 1890.0
          },
          "channel": {
            "type": "string",
            "example": "WEBSITE",
            "enum": [
              "APP",
              "WEBSITE",
              "APP",
              "WEBSITE"
            ]
          },
          "status": {
            "type": "string",
            "description": "Si se omite, el pedido queda recibido.",
            "example": "RECEIVED",
            "enum": [
              "RECEIVED",
              "CONFIRMED",
              "PREPARING",
              "SHIPPED",
              "DELIVERED",
              "CANCELLED"
            ]
          }
        },
        "description": "Alta de un pedido asociado a un cliente existente"
      },
      "CreateCustomerRequest": {
        "required": [
          "email",
          "firstName",
          "maternalLastName",
          "paternalLastName"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "maxLength": 80,
            "minLength": 0,
            "type": "string",
            "example": "Mariana"
          },
          "paternalLastName": {
            "maxLength": 80,
            "minLength": 0,
            "type": "string",
            "example": "Castillo"
          },
          "maternalLastName": {
            "maxLength": 80,
            "minLength": 0,
            "type": "string",
            "example": "Reyes"
          },
          "email": {
            "maxLength": 160,
            "minLength": 0,
            "type": "string",
            "example": "mariana.castillo@correo.com"
          }
        },
        "description": "Alta de un cliente"
      },
      "ChangeStatusRequest": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "SHIPPED",
            "enum": [
              "RECEIVED",
              "CONFIRMED",
              "PREPARING",
              "SHIPPED",
              "DELIVERED",
              "CANCELLED"
            ]
          }
        }
      },
      "PageResponseOrderResponse": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "SuggestionResponse": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "ORDER_NUMBER",
              "CUSTOMER",
              "EMAIL",
              "PRODUCT"
            ]
          },
          "label": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "description": "Opción del typeahead. El valor es el término que filtra la lista al seleccionarse."
      }
    }
  }
}