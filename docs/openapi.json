{
    "openapi": "3.0.1",
    "info": {
        "title": "Mesa de pedidos",
        "description": "API REST para que el equipo de ventas gestione clientes y pedidos originados en la aplicaci\u00f3n y en el sitio web. El importe del pedido se calcula como precio unitario por cantidad. El pedido conserva una copia de los datos del cliente al momento de crearse.",
        "version": "v1"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8080",
            "description": "Generated server url"
        }
    ],
    "tags": [
        {
            "name": "Salud",
            "description": "Comprueba que el servicio y MongoDB responden"
        },
        {
            "name": "Pedidos",
            "description": "Pedidos originados en la aplicaci\u00f3n y en el sitio web"
        },
        {
            "name": "Usuarios",
            "description": "Clientes que realizan pedidos desde la aplicaci\u00f3n o el sitio web"
        }
    ],
    "paths": {
        "/api/v1/usuarios/{id}": {
            "get": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Consulta un cliente",
                "operationId": "obtener",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/UsuarioRespuesta"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Actualiza los datos de un cliente",
                "operationId": "actualizar",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ActualizarUsuarioSolicitud"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/UsuarioRespuesta"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Elimina un cliente sin pedidos",
                "operationId": "eliminar",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/v1/pedidos/{id}": {
            "get": {
                "tags": [
                    "Pedidos"
                ],
                "summary": "Consulta el detalle de un pedido",
                "operationId": "obtener_1",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PedidoRespuesta"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "Pedidos"
                ],
                "summary": "Reemplaza los datos operativos de un pedido",
                "operationId": "actualizar_1",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ActualizarPedidoSolicitud"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PedidoRespuesta"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Pedidos"
                ],
                "summary": "Elimina un pedido",
                "operationId": "eliminar_1",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/v1/usuarios": {
            "get": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Lista los clientes",
                "operationId": "listar",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/UsuarioRespuesta"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Crea un cliente",
                "operationId": "crear",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CrearUsuarioSolicitud"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/UsuarioRespuesta"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/pedidos": {
            "get": {
                "tags": [
                    "Pedidos"
                ],
                "summary": "Lista pedidos, con filtro por t\u00e9rmino y estatus",
                "operationId": "listar_1",
                "parameters": [
                    {
                        "name": "termino",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "estatus",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "pagina",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "format": "int32",
                            "default": 0
                        }
                    },
                    {
                        "name": "tamano",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "format": "int32",
                            "default": 20
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaginaRespuestaPedidoRespuesta"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Pedidos"
                ],
                "summary": "Crea un pedido",
                "operationId": "crear_1",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CrearPedidoSolicitud"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PedidoRespuesta"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/pedidos/{id}/estatus": {
            "patch": {
                "tags": [
                    "Pedidos"
                ],
                "summary": "Cambia el estatus y lo agrega al historial",
                "operationId": "cambiarEstatus",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CambiarEstatusSolicitud"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PedidoRespuesta"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/salud": {
            "get": {
                "tags": [
                    "Salud"
                ],
                "summary": "Estado del servicio y de la base",
                "operationId": "salud",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/pedidos/sugerencias": {
            "get": {
                "tags": [
                    "Pedidos"
                ],
                "summary": "Opciones del typeahead a partir de dos caracteres",
                "operationId": "sugerencias",
                "parameters": [
                    {
                        "name": "termino",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/SugerenciaRespuesta"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ActualizarUsuarioSolicitud": {
                "required": [
                    "apellidoMaterno",
                    "apellidoPaterno",
                    "correoElectronico",
                    "nombre"
                ],
                "type": "object",
                "properties": {
                    "nombre": {
                        "maxLength": 80,
                        "minLength": 0,
                        "type": "string"
                    },
                    "apellidoPaterno": {
                        "maxLength": 80,
                        "minLength": 0,
                        "type": "string"
                    },
                    "apellidoMaterno": {
                        "maxLength": 80,
                        "minLength": 0,
                        "type": "string"
                    },
                    "correoElectronico": {
                        "maxLength": 160,
                        "minLength": 0,
                        "type": "string"
                    }
                },
                "description": "Reemplazo de los datos de un cliente"
            },
            "UsuarioRespuesta": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "nombre": {
                        "type": "string"
                    },
                    "apellidoPaterno": {
                        "type": "string"
                    },
                    "apellidoMaterno": {
                        "type": "string"
                    },
                    "nombreCompleto": {
                        "type": "string"
                    },
                    "correoElectronico": {
                        "type": "string"
                    },
                    "creadoEn": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "actualizadoEn": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "ActualizarPedidoSolicitud": {
                "required": [
                    "canal",
                    "cantidad",
                    "codigoProducto",
                    "descripcionProducto",
                    "direccionEnvio",
                    "estatus",
                    "precio"
                ],
                "type": "object",
                "properties": {
                    "direccionEnvio": {
                        "maxLength": 240,
                        "minLength": 0,
                        "type": "string"
                    },
                    "codigoProducto": {
                        "pattern": "^[A-Za-z0-9-]{4,32}$",
                        "type": "string"
                    },
                    "descripcionProducto": {
                        "maxLength": 140,
                        "minLength": 0,
                        "type": "string"
                    },
                    "cantidad": {
                        "maximum": 99,
                        "minimum": 1,
                        "type": "integer",
                        "format": "int32"
                    },
                    "precio": {
                        "minimum": 0.01,
                        "exclusiveMinimum": false,
                        "type": "number"
                    },
                    "canal": {
                        "type": "string",
                        "enum": [
                            "APLICACION",
                            "SITIO_WEB"
                        ]
                    },
                    "estatus": {
                        "type": "string",
                        "enum": [
                            "RECIBIDO",
                            "CONFIRMADO",
                            "EN_PREPARACION",
                            "ENVIADO",
                            "ENTREGADO",
                            "CANCELADO"
                        ]
                    }
                },
                "description": "Reemplazo de los datos operativos del pedido. El cliente y el folio no cambian."
            },
            "ClienteRespuesta": {
                "type": "object",
                "properties": {
                    "nombre": {
                        "type": "string"
                    },
                    "apellidoPaterno": {
                        "type": "string"
                    },
                    "apellidoMaterno": {
                        "type": "string"
                    },
                    "nombreCompleto": {
                        "type": "string"
                    },
                    "correoElectronico": {
                        "type": "string"
                    }
                }
            },
            "EventoEstatusRespuesta": {
                "type": "object",
                "properties": {
                    "estatus": {
                        "type": "string",
                        "enum": [
                            "RECIBIDO",
                            "CONFIRMADO",
                            "EN_PREPARACION",
                            "ENVIADO",
                            "ENTREGADO",
                            "CANCELADO"
                        ]
                    },
                    "ocurridoEn": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "PedidoRespuesta": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "folio": {
                        "type": "string"
                    },
                    "canal": {
                        "type": "string",
                        "enum": [
                            "APLICACION",
                            "SITIO_WEB"
                        ]
                    },
                    "usuarioId": {
                        "type": "string"
                    },
                    "cliente": {
                        "$ref": "#/components/schemas/ClienteRespuesta"
                    },
                    "direccionEnvio": {
                        "type": "string"
                    },
                    "codigoProducto": {
                        "type": "string"
                    },
                    "descripcionProducto": {
                        "type": "string"
                    },
                    "cantidad": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "precio": {
                        "type": "number"
                    },
                    "importeTotal": {
                        "type": "number"
                    },
                    "estatus": {
                        "type": "string",
                        "enum": [
                            "RECIBIDO",
                            "CONFIRMADO",
                            "EN_PREPARACION",
                            "ENVIADO",
                            "ENTREGADO",
                            "CANCELADO"
                        ]
                    },
                    "historial": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/EventoEstatusRespuesta"
                        }
                    },
                    "creadoEn": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "actualizadoEn": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "CrearUsuarioSolicitud": {
                "required": [
                    "apellidoMaterno",
                    "apellidoPaterno",
                    "correoElectronico",
                    "nombre"
                ],
                "type": "object",
                "properties": {
                    "nombre": {
                        "maxLength": 80,
                        "minLength": 0,
                        "type": "string",
                        "example": "Mariana"
                    },
                    "apellidoPaterno": {
                        "maxLength": 80,
                        "minLength": 0,
                        "type": "string",
                        "example": "Castillo"
                    },
                    "apellidoMaterno": {
                        "maxLength": 80,
                        "minLength": 0,
                        "type": "string",
                        "example": "Reyes"
                    },
                    "correoElectronico": {
                        "maxLength": 160,
                        "minLength": 0,
                        "type": "string",
                        "example": "mariana.castillo@correo.com"
                    }
                },
                "description": "Alta de un cliente"
            },
            "CrearPedidoSolicitud": {
                "required": [
                    "canal",
                    "cantidad",
                    "codigoProducto",
                    "descripcionProducto",
                    "direccionEnvio",
                    "precio",
                    "usuarioId"
                ],
                "type": "object",
                "properties": {
                    "usuarioId": {
                        "type": "string",
                        "description": "Identificador del usuario",
                        "example": "665f1c2b8a0d1e2f3a4b5c6d"
                    },
                    "direccionEnvio": {
                        "maxLength": 240,
                        "minLength": 0,
                        "type": "string",
                        "example": "Av. Presidente Masaryk 111, Polanco, Miguel Hidalgo, CDMX, 11560"
                    },
                    "codigoProducto": {
                        "pattern": "^[A-Za-z0-9-]{4,32}$",
                        "type": "string",
                        "example": "LP-MOD-10442"
                    },
                    "descripcionProducto": {
                        "maxLength": 140,
                        "minLength": 0,
                        "type": "string",
                        "example": "Vestido midi de lino"
                    },
                    "cantidad": {
                        "maximum": 99,
                        "minimum": 1,
                        "type": "integer",
                        "format": "int32",
                        "example": 1
                    },
                    "precio": {
                        "minimum": 0.01,
                        "exclusiveMinimum": false,
                        "type": "number",
                        "description": "Precio unitario en MXN",
                        "example": 1890.0
                    },
                    "canal": {
                        "type": "string",
                        "example": "SITIO_WEB",
                        "enum": [
                            "APLICACION",
                            "SITIO_WEB",
                            "APLICACION",
                            "SITIO_WEB"
                        ]
                    },
                    "estatus": {
                        "type": "string",
                        "description": "Si se omite, el pedido queda en RECIBIDO",
                        "example": "RECIBIDO",
                        "enum": [
                            "RECIBIDO",
                            "CONFIRMADO",
                            "EN_PREPARACION",
                            "ENVIADO",
                            "ENTREGADO",
                            "CANCELADO"
                        ]
                    }
                },
                "description": "Alta de un pedido asociado a un cliente existente"
            },
            "CambiarEstatusSolicitud": {
                "required": [
                    "estatus"
                ],
                "type": "object",
                "properties": {
                    "estatus": {
                        "type": "string",
                        "example": "ENVIADO",
                        "enum": [
                            "RECIBIDO",
                            "CONFIRMADO",
                            "EN_PREPARACION",
                            "ENVIADO",
                            "ENTREGADO",
                            "CANCELADO"
                        ]
                    }
                }
            },
            "PaginaRespuestaPedidoRespuesta": {
                "type": "object",
                "properties": {
                    "contenido": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PedidoRespuesta"
                        }
                    },
                    "pagina": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "tamano": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "totalElementos": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "totalPaginas": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "SugerenciaRespuesta": {
                "type": "object",
                "properties": {
                    "tipo": {
                        "type": "string"
                    },
                    "etiqueta": {
                        "type": "string"
                    },
                    "detalle": {
                        "type": "string"
                    },
                    "valor": {
                        "type": "string"
                    }
                },
                "description": "Opci\u00f3n del typeahead. El valor es el t\u00e9rmino que filtra la lista al seleccionarse."
            }
        }
    }
}
